module myon.stdio
module myon.map
m = myon.map(str, int)
m.set("a", 1)
m.set("b", 2)
m.set("c", 3)
myon.print(m.keys())
myon.print(m.values())
m.set("b", 20)
myon.print(m.keys())
myon.print(m.values())
m.delete("b")
m.set("b", 200)
myon.print(m.keys())
myon.print(m.values())
myon.print(m.length())
ints = myon.map(int, int)
myon.for i myon.in range(0, 10000) { ints.set(i, i * 2) }
myon.print(ints.length())
myon.print(ints.get(9999))
ints.delete(0)
ints.delete(5000)
ints.delete(9999)
myon.print(ints.length())
myon.print(ints.has(0))
myon.print(ints.get(100))
