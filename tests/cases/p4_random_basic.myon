# Phase4 Step6: myon.random.seed / int / float.
# The concrete random values depend on the C library's rand() implementation,
# so only the deterministic invariants are printed (range membership, the
# lo > hi error, and the [0.0, 1.0) bound). Reproducibility of srand+rand is
# verified manually per the instructions.
module myon.stdio
module myon.random

myon.random.seed(42)

# int(1, 6) x 10 must always land in [1, 6]
in_range = true
i = 0
myon.while i < 10 {
    v, verr = myon.random.int(1, 6)
    myon.if v < 1 myon.or v > 6 then { in_range = false }
    i += 1
}
myon.print(in_range)              # true

# lo > hi -> error
b, berr = myon.random.int(5, 1)
myon.if berr != myon.nil then { myon.print(str("int_lohi_err")) } myon.else { myon.print(str("int_lohi_ok")) }

# float() x 10 must always land in [0.0, 1.0)
f_ok = true
j = 0
myon.while j < 10 {
    f = myon.random.float()
    myon.if f < 0.0 myon.or f >= 1.0 then { f_ok = false }
    j += 1
}
myon.print(f_ok)                  # true

# Full-width intervals and bounds that exceed the range of a single rand().
lo = -9223372036854775807 - 1
hi = 9223372036854775807
whole, whole_error = myon.random.int(lo, hi)
myon.print(whole_error == myon.nil)
edge, edge_error = myon.random.int(lo, lo)
myon.print(edge_error == myon.nil myon.and edge == lo)
wide, wide_error = myon.random.int(hi - 100, hi)
myon.print(wide_error == myon.nil myon.and wide >= hi - 100 myon.and wide <= hi)
myon.random.seed(42)
first, first_error = myon.random.int(lo, hi)
myon.random.seed(42)
again, again_error = myon.random.int(lo, hi)
myon.print(first == again)

secure, secure_error = myon.random.secure_int(lo, hi)
secure_edge, secure_edge_error = myon.random.secure_int(hi, hi)
myon.if secure_error == myon.nil then {
    myon.print(secure_edge_error == myon.nil myon.and secure_edge == hi)
} myon.else {
    # Targets without the OS source should consistently report an error.
    myon.print(secure_edge_error != myon.nil)
}
